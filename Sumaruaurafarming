    updateCharacterReferences(player.Character or player.CharacterAdded:Wait())
end)

player.CharacterAdded:Connect(function(char)
    updateCharacterReferences(char)
    if spawnPosition then
        task.wait(0.1)
        teleportToSpawn()
    end
    if enabled or floor50Enabled then
        task.wait(0.2)
        stopFlight()
        startFlight()
    end
end)

local function enableCollector(toggleWidget)
    if enabled then return end

    cakeFolder = Workspace:FindFirstChild(FOLDER_NAME)
    if not cakeFolder then
        Fluent:Notify({
            Title = "System Error",
            Content = "ไม่พบโฟลเดอร์ '" .. FOLDER_NAME .. "' ในแมปนี้!",
            Duration = 5
        })
        if toggleWidget then toggleWidget:SetValue(false) end
        return
    end

    if not rootPart then
        updateCharacterReferences(player.Character)
        if not rootPart then 
            if toggleWidget then toggleWidget:SetValue(false) end
            return 
        end
    end

    enabled    = true
    queue      = {}
    collecting = false

    startFlight()

    for _, child in ipairs(cakeFolder:GetChildren()) do
        if child:IsA("Model") or child:IsA("BasePart") then
            table.insert(queue, child)
        end
    end

    folderConn = cakeFolder.ChildAdded:Connect(function(child)
        if enabled and (child:IsA("Model") or child:IsA("BasePart")) then
            table.insert(queue, child)
        end
    end)

    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not enabled or not rootPart or not rootPart.Parent then return end

        if #queue > 0 and not collecting then
            collecting   = true
            local target = getClosest()
            if not target then collecting = false return end

            task.spawn(function()
                local SLOW_DIST = 20
                local MIN_SPEED = 20

                while enabled and target and target.Parent and rootPart do
                    local centre = getCentre(target)
                    if not centre then break end

                    local dest  = centre + OFFSET
                    local delta = dest - rootPart.Position
                    local dist  = delta.Magnitude

                    if dist <= 1 then
                        rootPart.CFrame = CFrame.new(dest)
                        break
                    end

                    local speed
                    if dist <= SLOW_DIST then
                        speed = math.max(MIN_SPEED, dashSpeed * (dist / SLOW_DIST))
                    else
                        speed = dashSpeed
                    end

                    local dt       = RunService.Heartbeat:Wait()
                    local stepSize = speed * dt

                    if stepSize >= dist then
                        rootPart.CFrame = CFrame.new(dest)
                        break
                    end

                    setVelocity(delta.Unit * speed)
                end

                if enabled and rootPart then
                    local centre = getCentre(target)
                    if centre then rootPart.CFrame = CFrame.new(centre + OFFSET) end
                    setVelocity(Vector3.new(0, 0, 0))
                    task.wait(1)
                    setVelocity(Vector3.new(0, flySpeed, 0))
                end

                collecting = false
            end)
        elseif #queue == 0 and not collecting then
            setVelocity(Vector3.new(0, flySpeed, 0))
        end
    end)
end

local function disableCollector()
    if not enabled then return end
    enabled = false
    if heartbeatConn then heartbeatConn:Disconnect() end
    if folderConn    then folderConn:Disconnect()    end
    queue      = {}
    collecting = false
    stopFlight()
end

------------------------------------------------------------------------
-- 🚀 ฟังก์ชันแบบผันแปร: บินไป Floor 50 ก่อน -> เมื่อถึงแล้วรอให้ Part ชิ้นที่ 4 เกิด
------------------------------------------------------------------------
local function enableFloor50Fly(toggleWidget)
    if floor50Enabled then return end
    
    -- ดึงเป้าหมายหลักคือ Floor50 ขึ้นมาก่อน (ใช้ WaitForChild เผื่อโหลดไม่ทัน)
    local spiralTower = Workspace:FindFirstChild("SpiralTower")
    local floor50 = spiralTower and spiralTower:WaitForChild("Floor50", 10)

    if not floor50 then
        Fluent:Notify({
            Title = "System Error",
            Content = "ไม่พบจุดตั้งหลัก workspace.SpiralTower.Floor50 !",
            Duration = 5
        })
        if toggleWidget then toggleWidget:SetValue(false) end
        return
    end

    if not rootPart then
        updateCharacterReferences(player.Character)
        if not rootPart then 
            if toggleWidget then toggleWidget:SetValue(false) end
            return 
        end
    end

    floor50Enabled = true
    startFlight()

    floor50Conn = RunService.Heartbeat:Connect(function()
        if not floor50Enabled or not rootPart or not rootPart.Parent then return end
        
        -- ตรวจสอบหาพาร์ทชิ้นที่ 4 ภายใน Walls ของ Floor50 แบบ Real-time
        local wallsFolder = floor50:FindFirstChild("Walls")
        local targetPart = nil
        if wallsFolder then
            local children = wallsFolder:GetChildren()
            targetPart = children[4]
        end

        local finalTarget = targetPart or floor50 -- ถ้ามีชิ้นที่ 4 ให้พุ่งหาชิ้นที่ 4 ถ้ายังไม่มีให้บินไปรอที่ Floor50 ก่อน
        local targetPos = getCentre(finalTarget)
        
        if not targetPos then return end
        
        local dest = targetPos + OFFSET
        local delta = dest - rootPart.Position
        local dist = delta.Magnitude
        
        -- ตรรกะการเคลื่อนที่เข้าหาจุดหมาย
        if dist <= 2 then
            rootPart.CFrame = CFrame.new(dest)
            setVelocity(Vector3.new(0, 0, 0))
        else
            local speed = dashSpeed
            setVelocity(delta.Unit * speed)
        end
    end)
end

local function disableFloor50Fly()
    if not floor50Enabled then return end
    floor50Enabled = false
    if floor50Conn then floor50Conn:Disconnect() floor50Conn = nil end
    stopFlight()
end

player.CharacterRemoving:Connect(function()
    if enabled or floor50Enabled then stopFlight() end
end)

