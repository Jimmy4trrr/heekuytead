------------------------------------------------------------------------
-- Core Logic Functions
------------------------------------------------------------------------
local function getCentre(obj)
    if not obj then return nil end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local cf = obj:GetBoundingBox()
        return cf.Position
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

local function getClosest()
    if not rootPart then return nil end
    local best, bestDist = nil, math.huge
    for i, obj in ipairs(queue) do
        if obj and obj.Parent then
            local c = getCentre(obj)
            if c then
                local d = (c - rootPart.Position).Magnitude
                if d < bestDist then bestDist = d best = i end
            end
        end
    end
    if best then
        local obj = queue[best]
        table.remove(queue, best)
        return obj
    end
end

local function setVelocity(vec)
    if bv and bv.Parent then bv.Velocity = vec end
    if bg and bg.Parent and vec.Magnitude > 0 and rootPart then
        bg.CFrame = CFrame.new(rootPart.Position, rootPart.Position + vec.Unit)
    end
end

local noclipConn
local function startNoclip()
    noclipConn = RunService.Stepped:Connect(function()
        if not character then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

local function stopNoclip()
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function startFlight()
    if not rootPart or not humanoid then return end
    startNoclip()
    humanoid.PlatformStand = true
    bv = Instance.new("BodyVelocity")
    bv.Name     = "CakeBV"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.new(0, flySpeed, 0)
    bv.Parent   = rootPart
    bg = Instance.new("BodyGyro")
    bg.Name      = "CakeBG"
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.CFrame    = rootPart.CFrame
    bg.Parent    = rootPart
end

local function stopFlight()
    stopNoclip()
    if humanoid then humanoid.PlatformStand = false end
    if bv and bv.Parent then bv:Destroy() end
    if bg and bg.Parent then bg:Destroy() end
end

local function teleportToSpawn()
    if not spawnPosition or not character then return end
    local rp = character:FindFirstChild("HumanoidRootPart")
    if rp then rp.CFrame = CFrame.new(spawnPosition) end
end

local function updateCharacterReferences(char)
    if not char then return end
    character = char
    humanoid  = char:WaitForChild("Humanoid", 5)
    rootPart  = char:WaitForChild("HumanoidRootPart", 5)
end

