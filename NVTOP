-- TAB 0: OP HEAD SPOOFER SYSTEM
-- =================================================================
local headSpoofChance = 0 -- 0 = Off, 100 = 100%, 70 = 70%, 50 = 50%

if not getgenv().TargetSpoof_Hooked then
    getgenv().TargetSpoof_Hooked = true

    local originalIndex
    originalIndex = hookmetamethod(game, "__index", newcclosure(function(self, property)
        if headSpoofChance > 0 and not checkcaller() and property == "Name" then
            if typeof(self) == "Instance" and self:IsA("BasePart") then
                local callerScript = getcallingscript()
                if callerScript and (callerScript.Name == "LocalScript" or (callerScript.Parent and callerScript.Parent:IsA("Tool"))) then
                    -- คำนวณตาม % ที่เลือก
                    if headSpoofChance >= 100 or math.random(1, 100) <= headSpoofChance then
                        return "Head"
                    end
                end
            end
        end
        return originalIndex(self, property)
    end))
end

