local autoEatFood = false
local autoBuyFood = false

local bagRemote = ReplicatedStorage:WaitForChild("RemoteEvent_Solf")
    :WaitForChild("RemoteEventA")
    :WaitForChild("Bag")

local shopRemote = ReplicatedStorage:WaitForChild("ShopEvent")

local function getHold()
    return LocalPlayer.PlayerGui.Backpack_Never.Check.hold
end

local function getDelay()
    return LocalPlayer.PlayerGui.Backpack_Never.Check.delay
end

FoodTab:CreateToggle({
    Name = "ออโต้กินอาหาร น้ำ",
    CurrentValue = false,
    Flag = "AutoEatFoodToggle",
    Callback = function(Value)
        autoEatFood = Value
        if autoEatFood then
            task.spawn(function()
                while autoEatFood do
                    pcall(function()
                        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                        local statusHud = playerGui and playerGui:FindFirstChild("controler") and playerGui.controler.Status.Hud
                        
                        if statusHud then
                            local hungerTextObj = statusHud.hunger.Amount
                            local thirstTextObj = statusHud.thirst.Amount

                            local hungerVal = tonumber(hungerTextObj.Text) or tonumber(hungerTextObj.txet) or 100
                            local thirstVal = tonumber(thirstTextObj.Text) or tonumber(thirstTextObj.txet) or 100

                            -- 1. ลำดับกิน Onigiri ก่อนเมื่อความหิว <= 79
                            if hungerVal <= 79 then
                                bagRemote:FireServer("Use", "Onigiri", getHold(), getDelay())
                                Rayfield:Notify({
                                    Title = "Auto Eat",
                                    Content = "กิน Onigiri เรียบร้อย! รอคูลดาวน์ 12 วิ...",
                                    Duration = 3
                                })
                                task.wait(12)

                            -- 2. ถ้าความหิวไม่อยู่ในเงื่อนไข ค่อยกิน Water เมื่อความกระหาย <= 79
                            elseif thirstVal <= 79 then
                                bagRemote:FireServer("Use", "Water", getHold(), getDelay())
                                Rayfield:Notify({
                                    Title = "Auto Drink",
                                    Content = "ดื่ม Water เรียบร้อย! รอคูลดาวน์ 12 วิ...",
                                    Duration = 3
                                })
                                task.wait(12)
                            end
                        end
                    end)
                    task.wait(1)
                end
            end)
        end
    end,
})

