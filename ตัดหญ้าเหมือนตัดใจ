-- Functions
local function IsBackpackFull()
    local isFull = false
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return end
        
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") and gui.Visible then
                local text = gui.Text
                if text:find("Full") or text:find("FULL") then
                    isFull = true
                    break
                end
                
                local current, max = text:match("(%d+)%s*/%s*(%d+)")
                if current and max and tonumber(current) >= tonumber(max) and tonumber(max) > 0 then
                    isFull = true
                    break
                end
            end
        end
    end)
    return isFull
end

