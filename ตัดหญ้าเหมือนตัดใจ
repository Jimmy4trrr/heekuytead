local function GetBestTargetLoot()
    local selected = Options.SelectedRarities.Value
    local bestModel, bestPart = nil, nil
    local bestPriority = math.huge
    local shortestDist = math.huge
    
    if not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) then
        return nil, nil
    end
    
    local hrpPos = LocalPlayer.Character.HumanoidRootPart.Position

    for _, zone in ipairs(Workspace.Zones:GetChildren()) do
        local spawnZone = zone:FindFirstChild("SpawnZone")
        if spawnZone then
            for _, model in ipairs(spawnZone:GetChildren()) do
                local lootGui = model:FindFirstChild("LootGui")
                if lootGui and lootGui:FindFirstChild("Rarity") then
                    local rarityText = lootGui.Rarity.Text
                    local isMatched = false
                    
                    if selected["Nearest"] then
                        isMatched = true
                    elseif selected[rarityText] then
                        isMatched = true
                    end

                    if isMatched then
                        local primaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                        if primaryPart then
                            local priority = RarityPriority[rarityText] or 99
                            local dist = (hrpPos - primaryPart.Position).Magnitude
                            
                            if priority < bestPriority then
                                bestPriority = priority
                                shortestDist = dist
                                bestPart = primaryPart
                                bestModel = model
                            elseif priority == bestPriority and dist < shortestDist then
                                shortestDist = dist
                                bestPart = primaryPart
                                bestModel = model
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestModel
end

task.spawn(function()
    while task.wait(0.01) do
        if Options.AutoCollectRarity and Options.AutoCollectRarity.Value then
            local targetPart, targetModel = GetBestTargetLoot()
            if targetPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                if Options.FarmMethod.Value == "Teleport" then
                    hrp.CFrame = targetPart.CFrame * CFrame.new(0, 2, 0)
                elseif Options.FarmMethod.Value == "Walk" then
                    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if hum then hum:MoveTo(targetPart.Position) end
                end
                
                FastInteractWithLoot(targetModel)
                task.wait(0.08)
            end
        end
    end
end)

-- 3. Auto Farm OP
local WorldConfigs = {
    [1] = CFrame.new(522.892944, 32.9000015, 0.100000001, 1, 0, 0, 0, 1, 0, 0, 0, 1),
    [2] = CFrame.new(765.442749, 32.9000015, 1706.30005, 1, 0, 0, 0, 1, 0, 0, 0, 1),
    [3] = CFrame.new(763.41803, 34.6999893, 3460.30542, 1, 0, 0, 0, 1, 0, 0, 0, 1)
}

Tabs.AutoFarmOP:AddSlider("DistanceThreshold", {
    Title = "Max Teleport Distance",
    Default = 300,
    Min = 1,
    Max = 500,
    Rounding = 0
})

for worldNum = 1, 3 do
    Tabs.AutoFarmOP:AddButton({
        Title = "Teleport World " .. worldNum,
        Callback = function()
            WorldRemote:InvokeServer(worldNum)
        end
    })
    
    Tabs.AutoFarmOP:AddToggle("AutoFarmW" .. worldNum, { 
        Title = "Auto Farm World " .. worldNum, 
        Default = false 
    })
    
    task.spawn(function()
        local lastTeleportTime = 0
        
        while task.wait(0.01) do
            local toggleKey = "AutoFarmW" .. worldNum
            if Options[toggleKey] and Options[toggleKey].Value then
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character.HumanoidRootPart
                    local targetCF = WorldConfigs[worldNum]
                    local currentTime = tick()
                    local maxDistance = Options.DistanceThreshold and Options.DistanceThreshold.Value or 300
                    
                    if IsBackpackFull() then
                        pcall(function()
                            SpawnRemote:InvokeServer()
                        end)
                        task.wait(1)
                    elseif (currentTime - lastTeleportTime >= 20) or (hrp.Position - targetCF.Position).Magnitude > maxDistance then
                        hrp.CFrame = targetCF
                        lastTeleportTime = currentTime
                        task.wait(0.3)
                    else
                        local lootTarget, lootModel = GetBestTargetLoot()
                        if lootTarget then
                            local farmMethod = Options.FarmMethod and Options.FarmMethod.Value or "Teleport"
                            if farmMethod == "Teleport" then
                                hrp.CFrame = lootTarget.CFrame * CFrame.new(0, 2, 0)
                            elseif farmMethod == "Walk" then
                                local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                                if hum then
                                    hum:MoveTo(lootTarget.Position)
                                end
                            end
                            
                            FastInteractWithLoot(lootModel)
                            task.wait(0.08)
                        end
                    end
                end
            else
                lastTeleportTime = 0
            end
        end
    end)
end

