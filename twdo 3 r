-- ADVANCED ESP SYSTEM (DRAWING BASED)
---------------------------------------------------------
local ESPObjects = {}

local function CreateESP(player)
    if player == LocalPlayer then return end

    local objects = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        HealthBarOutline = Drawing.new("Square"),
        HealthBar = Drawing.new("Square")
    }

    -- Box Settings
    objects.Box.Color = Color3.fromRGB(255, 50, 50)
    objects.Box.Thickness = 2
    objects.Box.Filled = false
    objects.Box.Visible = false

    -- Name Settings
    objects.Name.Color = Color3.fromRGB(255, 255, 255)
    objects.Name.Size = 16
    objects.Name.Center = true
    objects.Name.Outline = true
    objects.Name.OutlineColor = Color3.fromRGB(0, 0, 0)
    objects.Name.Visible = false

    -- Distance Settings
    objects.Distance.Color = Color3.fromRGB(220, 220, 220)
    objects.Distance.Size = 14
    objects.Distance.Center = true
    objects.Distance.Outline = true
    objects.Distance.OutlineColor = Color3.fromRGB(0, 0, 0)
    objects.Distance.Visible = false

    -- Health Bar Settings
    objects.HealthBarOutline.Color = Color3.fromRGB(0, 0, 0)
    objects.HealthBarOutline.Thickness = 1
    objects.HealthBarOutline.Filled = true
    objects.HealthBarOutline.Visible = false

    objects.HealthBar.Color = Color3.fromRGB(0, 255, 0)
    objects.HealthBar.Thickness = 2.5
    objects.HealthBar.Filled = true
    objects.HealthBar.Visible = false

    ESPObjects[player] = objects
end

local function RemoveESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            obj:Remove()
        end
        ESPObjects[player] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

-- ESP Update Loop
RunService.RenderStepped:Connect(function()
    for player, objs in pairs(ESPObjects) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if ESPMaster and char and hrp and hum and hum.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                local head = char:FindFirstChild("Head")
                local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))

                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 1.8

                -- 1. Box ESP
                if ESPBox then
                    objs.Box.Size = Vector2.new(width, height)
                    objs.Box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                    objs.Box.Visible = true
                else
                    objs.Box.Visible = false
                end

                -- 2. Name ESP
                if ESPName then
                    objs.Name.Text = player.DisplayName or player.Name
                    objs.Name.Position = Vector2.new(pos.X, pos.Y - height / 2 - 20)
                    objs.Name.Visible = true
                else
                    objs.Name.Visible = false
                end

                -- 3. Distance ESP
                if ESPDistance then
                    local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                    objs.Distance.Text = "[" .. dist .. "m]"
                    objs.Distance.Position = Vector2.new(pos.X, pos.Y + height / 2 + 4)
                    objs.Distance.Visible = true
                else
                    objs.Distance.Visible = false
                end

                -- 4. Health Bar ESP
                if ESPHealth then
                    local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local barHeight = height * healthPercent

                    objs.HealthBarOutline.Size = Vector2.new(4, height + 2)
                    objs.HealthBarOutline.Position = Vector2.new(pos.X - width / 2 - 8, pos.Y - height / 2 - 1)
                    objs.HealthBarOutline.Visible = true

                    objs.HealthBar.Size = Vector2.new(2, barHeight)
                    objs.HealthBar.Position = Vector2.new(pos.X - width / 2 - 7, (pos.Y + height / 2) - barHeight)
                    objs.HealthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)
                    objs.HealthBar.Visible = true
                else
                    objs.HealthBarOutline.Visible = false
                    objs.HealthBar.Visible = false
                end
            else
                for _, obj in pairs(objs) do obj.Visible = false end
            end
        else
            for _, obj in pairs(objs) do obj.Visible = false end
        end
    end
end)

