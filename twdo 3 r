-- AIMBOT & MISC LOGIC
---------------------------------------------------------
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = FOVRadius

    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(AimTargetPart) and player.Character:FindFirstChildOfClass("Humanoid") and player.Character.Humanoid.Health > 0 then
            local targetPart = player.Character[AimTargetPart]
            
            local worldDist = (targetPart.Position - myHRP.Position).Magnitude
            if worldDist <= MaxDistance then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)

                if onScreen then
                    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude

                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Main Loop (Aimbot, FOV & Noclip)
RunService.Stepped:Connect(function()
    if NoclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = ShowFOV
    FOVCircle.Radius = FOVRadius
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if AimbotEnabled then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild(AimTargetPart) then
            local targetPos = target.Character[AimTargetPart].Position
            local currentCamCFrame = Camera.CFrame
            local targetCFrame = CFrame.new(currentCamCFrame.Position, targetPos)
            
            Camera.CFrame = currentCamCFrame:Lerp(targetCFrame, 1 / AimSmoothing)
        end
    end
end)

local function ToggleNoRecoil(val)
    NoRecoilEnabled = val
    task.spawn(function()
        while NoRecoilEnabled do
            task.wait(0.1)
            for _, v in pairs(getgc(true)) do
                if type(v) == "table" then
                    if rawget(v, "Recoil") or rawget(v, "recoil") then
                        v.Recoil = 0
                        v.recoil = 0
                    end
                    if rawget(v, "CameraShake") or rawget(v, "recoilShift") then
                        v.CameraShake = 0
                        v.recoilShift = 0
                    end
                end
            end
        end
    end)
end

---------------------------------------------------------
-- KILL AURA LOGIC
---------------------------------------------------------
local function AttackTarget(targetPart)
    if not targetPart then return end
    
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local attackPos = targetPart.Position
    local attackCFrame = CFrame.new(myHRP.Position, attackPos)

    FightEvent:FireServer("Use1", attackPos, attackCFrame)
end

task.spawn(function()
    while true do
        task.wait(0.2)
        
        if KillAuraEnabled then
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

            if myHRP then
                -- 1. โจมตีผู้เล่น
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                        local targetHum = player.Character:FindFirstChildOfClass("Humanoid")

                        if targetHRP and targetHum and targetHum.Health > 0 then
                            local dist = (targetHRP.Position - myHRP.Position).Magnitude
                            if dist <= KillAuraRange then
                                AttackTarget(targetHRP)
                            end
                        end
                    end
                end

                -- 2. โจมตี NPC / Zombie
                if TargetNPCs then
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("Humanoid") and obj.Parent ~= myChar and obj.Health > 0 then
                            if not Players:GetPlayerFromCharacter(obj.Parent) then
                                local targetHRP = obj.Parent:FindFirstChild("HumanoidRootPart") or obj.Parent:FindFirstChild("PrimaryPart")
                                if targetHRP then
                                    local dist = (targetHRP.Position - myHRP.Position).Magnitude
                                    if dist <= KillAuraRange then
                                        AttackTarget(targetHRP)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

