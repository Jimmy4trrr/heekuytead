local ESPObjects = {}

local function RemoveESP(player)
    if ESPObjects[player] then
        pcall(function()
            if ESPObjects[player].Highlight then ESPObjects[player].Highlight:Destroy() end
            if ESPObjects[player].Name then ESPObjects[player].Name:Remove() end
            if ESPObjects[player].Distance then ESPObjects[player].Distance:Remove() end
            if ESPObjects[player].HealthBarOutline then ESPObjects[player].HealthBarOutline:Remove() end
            if ESPObjects[player].HealthBar then ESPObjects[player].HealthBar:Remove() end
        end)
        ESPObjects[player] = nil
    end
end

local function SetupPlayerESP(player)
    if player == LocalPlayer then return end
    RemoveESP(player)

    local objects = {
        Highlight = nil,
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        HealthBarOutline = Drawing.new("Square"),
        HealthBar = Drawing.new("Square")
    }

    objects.Name.Color = Color3.fromRGB(255, 255, 255)
    objects.Name.Size = 16
    objects.Name.Center = true
    objects.Name.Outline = true
    objects.Name.OutlineColor = Color3.fromRGB(0, 0, 0)
    objects.Name.Visible = false

    objects.Distance.Color = Color3.fromRGB(220, 220, 220)
    objects.Distance.Size = 14
    objects.Distance.Center = true
    objects.Distance.Outline = true
    objects.Distance.OutlineColor = Color3.fromRGB(0, 0, 0)
    objects.Distance.Visible = false

    objects.HealthBarOutline.Color = Color3.fromRGB(0, 0, 0)
    objects.HealthBarOutline.Thickness = 1
    objects.HealthBarOutline.Filled = true
    objects.HealthBarOutline.Visible = false

    objects.HealthBar.Color = Color3.fromRGB(0, 255, 0)
    objects.HealthBar.Thickness = 2.5
    objects.HealthBar.Filled = true
    objects.HealthBar.Visible = false

    ESPObjects[player] = objects

    local function OnCharacterAdded(character)
        task.wait(0.2)
        if not ESPObjects[player] then return end

        if ESPObjects[player].Highlight then
            pcall(function() ESPObjects[player].Highlight:Destroy() end)
        end

        local highlight = Instance.new("Highlight")
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = character
        highlight.Enabled = (ESPMaster and ESPChams)
        highlight.Parent = character

        ESPObjects[player].Highlight = highlight
    end

    if player.Character then task.spawn(OnCharacterAdded, player.Character) end
    player.CharacterAdded:Connect(OnCharacterAdded)
end

for _, p in pairs(Players:GetPlayers()) do SetupPlayerESP(p) end
Players.PlayerAdded:Connect(SetupPlayerESP)
Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    for player, objs in pairs(ESPObjects) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if ESPMaster and char and hrp and hum and hum.Health > 0 then
            if objs.Highlight then objs.Highlight.Enabled = ESPChams end

            local cf, size = char:GetBoundingBox()
            local topWorld = cf.Position + Vector3.new(0, (size.Y / 2) + 0.3, 0)
            local bottomWorld = cf.Position - Vector3.new(0, (size.Y / 2) + 0.3, 0)

            local topPos, topOnScreen = Camera:WorldToViewportPoint(topWorld)
            local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint(bottomWorld)

            if topOnScreen or bottomOnScreen then
                local height = math.abs(topPos.Y - bottomPos.Y)
                local width = height / 1.45
                local centerPos = Camera:WorldToViewportPoint(cf.Position)

                if ESPName then
                    objs.Name.Text = player.DisplayName or player.Name
                    objs.Name.Position = Vector2.new(centerPos.X, centerPos.Y - height / 2 - 18)
                    objs.Name.Visible = true
                else
                    objs.Name.Visible = false
                end

                if ESPDistance then
                    local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                    objs.Distance.Text = "[" .. dist .. "m]"
                    objs.Distance.Position = Vector2.new(centerPos.X, centerPos.Y + height / 2 + 4)
                    objs.Distance.Visible = true
                else
                    objs.Distance.Visible = false
                end

                if ESPHealth then
                    local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local barHeight = height * healthPercent

                    objs.HealthBarOutline.Size = Vector2.new(4, height + 2)
                    objs.HealthBarOutline.Position = Vector2.new(centerPos.X - width / 2 - 7, centerPos.Y - height / 2 - 1)
                    objs.HealthBarOutline.Visible = true

                    objs.HealthBar.Size = Vector2.new(2, barHeight)
                    objs.HealthBar.Position = Vector2.new(centerPos.X - width / 2 - 6, (centerPos.Y + height / 2) - barHeight)
                    objs.HealthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)
                    objs.HealthBar.Visible = true
                else
                    objs.HealthBarOutline.Visible = false
                    objs.HealthBar.Visible = false
                end
            else
                objs.Name.Visible = false
                objs.Distance.Visible = false
                objs.HealthBarOutline.Visible = false
                objs.HealthBar.Visible = false
            end
        else
            if objs.Highlight then objs.Highlight.Enabled = false end
            objs.Name.Visible = false
            objs.Distance.Visible = false
            objs.HealthBarOutline.Visible = false
            objs.HealthBar.Visible = false
        end
    end
end)

