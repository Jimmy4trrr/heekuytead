task.spawn(function()
   local player = game.Players.LocalPlayer
   
   while true do
      task.wait(0.01)
      if _G.SelectedQuest then
         local character = player.Character
         local rootPart = character and character:FindFirstChild("HumanoidRootPart")
         local humanoid = character and character:FindFirstChild("Humanoid")
         
         if rootPart and humanoid and humanoid.Health > 0 then
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            local targetMob = nil
            local mobsFolder = workspace:FindFirstChild("Mobs")
            
            if mobsFolder then
               local targetFolder = mobsFolder:FindFirstChild(_G.SelectedQuest)
               if targetFolder then
                  for _, mob in ipairs(targetFolder:GetChildren()) do
                     if mob:IsA("Model") then
                        local mobHumanoid = mob:FindFirstChild("Humanoid")
                        local mobRoot = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head")
                        
                        if mobHumanoid and mobHumanoid.Health > 0 and mobRoot then
                           targetMob = mobRoot
                           break
                        end
                     end
                  end
               end
            end
            
            if targetMob then
               local topPosition = targetMob.Position + Vector3.new(0, 7, 0.1)
               rootPart.CFrame = CFrame.lookAt(topPosition, targetMob.Position)
            end
         end
      end
   end
end)

local function setupMob(mob)
   local humanoid = mob:WaitForChild("Humanoid", 5)
   if humanoid and humanoid:IsA("Humanoid") then
      local connection
      connection = humanoid.HealthChanged:Connect(function(currentHealth)
         if not _G.AutoKillQuestMobs then return end
         local maxHealth = humanoid.MaxHealth
         if maxHealth > 0 then
            local healthPercent = (currentHealth / maxHealth) * 100
            if healthPercent < 89 and currentHealth > 0 then
               humanoid.Health = 0
            end
         end
      end)
      
      mob.Destroying:Connect(function()
         if connection then connection:Disconnect() end
      end)
   end
end

local function startAutoKill()
   local mobsFolder = workspace:WaitForChild("Mobs", 10)
   if not mobsFolder then return end

   for _, folder in ipairs(mobsFolder:GetChildren()) do
      if folder:IsA("Folder") and string.match(folder.Name, "^Quest") then
         for _, mob in ipairs(folder:GetChildren()) do
            if mob:IsA("Model") then task.spawn(setupMob, mob) end
         end
         folder.ChildAdded:Connect(function(child)
            if child:IsA("Model") then task.spawn(setupMob, child) end
         end)
      end
   end
end

task.spawn(startAutoKill)
