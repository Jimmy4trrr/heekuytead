local function CreateQuestToggle(questNumber)
   local questName = "Quest" .. questNumber
   
   FarmTab:CreateToggle({
      Name = "Auto Farm " .. questName,
      CurrentValue = false,
      Flag = "AutoFarmToggle_" .. questName,
      Callback = function(Value)
         if Value then
            _G.SelectedQuest = questName
         else
            if _G.SelectedQuest == questName then
               _G.SelectedQuest = nil
            end
         end
      end,
   })
end

