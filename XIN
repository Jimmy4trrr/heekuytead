-- =================================================================
-- SYSTEM 1: INSTANT PROXIMITY PROMPT & INPUT HELPER
-- =================================================================
local function makeInstant(prompt)
    if prompt:IsA("ProximityPrompt") then
        prompt.HoldDuration = 0
    end
end

for _, v in ipairs(game:GetDescendants()) do
    makeInstant(v)
end
game.DescendantAdded:Connect(makeInstant)

local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    task.wait(0.05)
end

local function pressE()
    pressKey(Enum.KeyCode.E)
end

local function getItemValue(itemName)
    local itemFolder = LocalPlayer:FindFirstChild("Item")
    if not itemFolder then return 0 end
    
    local itemObj = itemFolder:FindFirstChild(itemName)
    if not itemObj then return 0 end
    
    return itemObj.Value or itemObj.value or 0
end

-- =================================================================
-- TAB 1: AUTO CANDY & FRUIT MANAGER
-- =================================================================
local playerItems = LocalPlayer:WaitForChild("Item")

local remoteSafe = ReplicatedStorage:WaitForChild("Game_Modules"):WaitForChild("RemoteEventSafe")
local depositRemote = remoteSafe:WaitForChild("DepositItem")
local withdrawRemote = remoteSafe:WaitForChild("WithdrawItem")

local craftRemote = ReplicatedStorage:WaitForChild("RemoteEvent_Solf")
    :WaitForChild("RemoteEventA")
    :WaitForChild("CraftsFolder")
    :WaitForChild("Crafttable")

local autoDepositFruits = false
local autoWithdrawFruits = false
local autoCraftCandy = false

local targetFruits = {
    "Cauliflower",
    "Corn",
    "Peach",
    "Grape",
    "Orange"
}

local function depositFruitsLogic()
    for _, fruitName in ipairs(targetFruits) do
        local fruitObject = playerItems:FindFirstChild(fruitName)
        if fruitObject and fruitObject.Value >= 90 then
            depositRemote:FireServer(fruitName, 90)
            task.wait(0.5)
        end
    end
end

local function withdrawFruitsLogic()
    for _, fruitName in ipairs(targetFruits) do
        local fruitObject = playerItems:FindFirstChild(fruitName)
        if fruitObject and fruitObject.Value == 0 then
            withdrawRemote:FireServer(fruitName, 100)
            task.wait(0.5)
        end
    end
end

local function craftAndManageCandyLogic()
    local candyObject = playerItems:FindFirstChild("Candy")
    
    local craftArgs = {
        "SeedCandy",
        "Recipe1",
        "5",
        false
    }
    craftRemote:FireServer(unpack(craftArgs))

    if candyObject and candyObject.Value >= 90 then
        depositRemote:FireServer("Candy", 90)
        task.wait(0.5)
    end
end

