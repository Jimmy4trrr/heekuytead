local autoMineFarm = false
local autoWithdrawGold = false
local autoWithdrawIron = false
local autoDepositItems = false

local function getFrameX()
    local autoMineUI = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("AutoMine")
    if not autoMineUI then return nil end
    local frame = autoMineUI:FindFirstChild("Frame")
    if not frame then return nil end
    for _, child in ipairs(frame:GetChildren()) do
        if child.Name:find("Frame_X") then return child end
    end
    return nil
end

local function selectMineUIOnce(btnName)
    local frameX = getFrameX()
    if not frameX then return false end
    
    local btn = frameX:FindFirstChild(btnName)
    if not btn then return false end

    GuiService.SelectedObject = btn
    task.wait(0.1)

    pressKey(Enum.KeyCode.Return)
    pressKey(Enum.KeyCode.Space)
    pressKey(Enum.KeyCode.ButtonA)

    task.wait(0.1)
    GuiService.SelectedObject = nil
    pressKey(Enum.KeyCode.BackSlash)
    
    return true
end

local function depositMineItems()
    local depositRemote = ReplicatedStorage:WaitForChild("Game_Modules"):WaitForChild("RemoteEventSafe"):WaitForChild("DepositItem")
    
    depositRemote:FireServer("MineGold", 500)
    task.wait(0.3)
    depositRemote:FireServer("MineIron", 500)
end

local function triggerAutoUiRemote()
    pcall(function()
        LocalPlayer:WaitForChild("PlayerGui")
                   :WaitForChild("AutoUi")
                   :WaitForChild("Frame")
                   :WaitForChild("TextButton")
                   :WaitForChild("LocalScript")
                   :WaitForChild("RemoteEvent")
                   :FireServer()
    end)
end

MineTab:CreateToggle({
   Name = "Auto Farm (Iron -> Gold -> Deposit)",
   CurrentValue = false,
   Flag = "AutoFarmFlag",
   Callback = function(Value)
       autoMineFarm = Value
       
       if autoMineFarm then
           task.spawn(function()
               local currentState = "NONE"

               while autoMineFarm do
                   local ironValue = getItemValue("MineIron")
                   local goldValue = getItemValue("MineGold")

                   if ironValue < 500 then
                       if currentState ~= "IRON" then
                           pressE()
                           task.wait(0.5)
                           selectMineUIOnce("MineIron")
                           currentState = "IRON"
                       end

                   elseif ironValue >= 500 and goldValue < 500 then
                       if currentState ~= "GOLD" then
                           triggerAutoUiRemote()
                           Rayfield:Notify({
                               Title = "Iron 500 Reached",
                               Content = "เหล็กครบ 500",
                               Duration = 2.5
                           })
                           task.wait(0.5)

                           pressE()
                           task.wait(0.5)
                           selectMineUIOnce("MineGold")
                           currentState = "GOLD"
                       end

                   elseif goldValue >= 500 then
                       triggerAutoUiRemote()
                       task.wait(0.3)

                       depositMineItems()
                       
                       Rayfield:Notify({
                           Title = "Gold 500 & Deposit",
                           Content = "ทองครบ 500",
                           Duration = 3
                       })
                       
                       currentState = "NONE"
                       task.wait(2)
                   end

                   task.wait(0.5)
               end
           end)
       end
   end,
})

